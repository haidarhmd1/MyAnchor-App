# Copy this file to .env.local and replace every bracketed placeholder.
DATABASE_URL="postgresql://myanchor:local-development-only@localhost:5432/myanchor?schema=public"
DATABASE_POOL_MAX=5
DATABASE_CONNECT_TIMEOUT_MS=5000
DATABASE_IDLE_TIMEOUT_MS=30000

AUTH_SECRET=[GENERATE_A_UNIQUE_RANDOM_SECRET]
AUTH_URL=http://localhost:3000

MAILERSEND_API_KEY=[MAILERSEND_API_KEY]
EMAIL_FROM=[MAILERSEND_EMAIL_FROM]
EMAIL_FROM_NAME=MyAnchor
OPENAI_API_KEY=[OPENAI_API_KEY]

# Non-production only; both must be set and the address must be allow-listed.
DEV_MASTER_OTP=
DEV_MASTER_OTP_EMAILS=

# Enable only behind a trusted platform that overwrites forwarding headers.
TRUST_PROXY_HEADERS=false
PRIVACY_POLICY_VERSION=2026-09-25

# Operational retention (scheduled cleanup; health records are user-controlled)
RETENTION_OTP_DAYS=1
RETENTION_EMAIL_LOG_DAYS=90
RETENTION_SIGN_IN_AUDIT_DAYS=365
RETENTION_RATE_LIMIT_DAYS=1

VAPID_PUBLIC_KEY=[VAPID_PUBLIC_KEY]
VAPID_PRIVATE_KEY=[VAPID_PRIVATE_KEY]
# Contact URI sent with every push (mailto: or https:), required by the VAPID spec.
VAPID_SUBJECT=mailto:support@myanchor.app
