{
  "name": "my-anchor-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "yarn@4.18.0",
  "engines": {
    "node": "24.19.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "yarn prisma:generate && next build --webpack",
    "start": "next start",
    "release": "prisma migrate deploy",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "prisma:validate": "prisma validate",
    "prisma:generate": "prisma generate",
    "seed": "tsx prisma/seed.ts",
    "db:seed": "prisma generate && yarn seed",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:status": "prisma migrate status",
    "db:reset": "prisma migrate reset --force && yarn db:seed",
    "db:push": "prisma db push",
    "maintenance:cleanup": "tsx scripts/cleanup-retention.ts"
  },
  "dependencies": {
